{
  "name": "athena-node",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "ATHENA Node — an independent Windows agent for an ATHENA Hub.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node athena-node.mjs",
    "check": "node tests/check.mjs",
    "test": "node --test tests",
    "test:computer": "node --test tests/computer-use.test.mjs",
    "test:lifecycle": "node --test tests/lifecycle.test.mjs",
    "package": "node tools/package.mjs",
    "package:portable": "node tools/package.mjs --no-installer"
  }
}
